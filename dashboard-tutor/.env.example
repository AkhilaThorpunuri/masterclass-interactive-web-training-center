# Set in your local shell or .env loader (this starter intentionally has no dotenv dependency)
ELEVENLABS_API_KEY=your-secret-api-key
ELEVENLABS_VOICE_ID=your-voice-id
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional if Chromium is not in Playwright's cache:
# TUTOR_CHROMIUM=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
# For silent end-to-end tests only:
# TUTOR_SILENT=1
